# ============ LLM 配置 ============
# DeepSeek API Key（支持任何兼容 OpenAI 格式的厂商）
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# ============ MCP Server 配置 ============
MCP_SERVER_URL=http://localhost:9000
MCP_HOST=0.0.0.0
MCP_PORT=9000

# ============ 存储与中间件配置 ============
# 关系型数据库 (默认使用本地 SQLite，也可配置 MySQL)
MYSQL_DSN=sqlite+aiosqlite:///./local_app.db
# Redis 缓存连接
REDIS_URL=redis://127.0.0.1:6379/0
# Qdrant 向量数据库
QDRANT_URL=http://127.0.0.1:6333
# Elasticsearch
ES_URL=http://127.0.0.1:9200

# ============ Embedding 向量配置 ============
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ============ Web API 服务配置 ============
APP_NAME=py-ai-framework
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ============ MCP 工具回调的后端服务配置 ============
ERP_BASE_URL=http://127.0.0.1:8000
HTTP_TIMEOUT=30
HTTP_MAX_CONNECTIONS=20
