# ==========================================
# 1. 基础应用配置
# ==========================================
APP_NAME=AI-Project-Framework
APP_ENV=dev
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-secret-key-in-production

# ==========================================
# 2. LLM 大模型配置 (支持 OpenAI / DeepSeek / 通义千问等兼容 API)
# ==========================================
LLM_API_KEY=sk-your-openai-or-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# ==========================================
# 3. 向量嵌入模型 (Embedding)
# ==========================================
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ==========================================
# 4. 数据库配置
# ==========================================
# 是否启用关系型数据库 (默认使用本地 SQLite 避免强依赖)
MYSQL_ENABLED=false
# MySQL 格式: mysql+aiomysql://root:password@127.0.0.1:3306/db_name?charset=utf8mb4
# SQLite 格式: sqlite+aiosqlite:///./local_app.db
MYSQL_DSN=sqlite+aiosqlite:///./local_app.db

# ==========================================
# 5. 缓存与消息中间件 (Redis)
# ==========================================
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0

# ==========================================
# 6. 向量数据库 (Qdrant)
# ==========================================
QDRANT_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333

# ==========================================
# 7. 全文检索 (Elasticsearch)
# ==========================================
ES_ENABLED=false
ES_URL=http://127.0.0.1:9200

# ==========================================
# 8. MCP (Model Context Protocol) 服务配置
# ==========================================
MCP_HOST=0.0.0.0
MCP_PORT=9000
